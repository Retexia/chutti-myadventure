# Copy to .env.local for local dev, and add the same keys in Vercel → Project Settings → Environment Variables.
# Supabase is optional: without it the game still works fully (progress saves in her browser),
# but your live HQ view, live hint messages and remote unlocks need it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Her login passcode — text it to her together with the link (default: 1130)
NEXT_PUBLIC_HER_PASSCODE=1130
# PIN for your secret control room at /piccalito-hq (default: ring-thief-1130)
NEXT_PUBLIC_GM_PIN=ring-thief-1130
